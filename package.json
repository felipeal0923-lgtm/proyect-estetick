{
  "name": "nuevo",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "concurrently --handle-input \"npm run backend\" \"expo start\"",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "backend": "node backend/server.js",
    "web": "concurrently --handle-input \"npm run backend\" \"expo start --web\"",
    "dev": "concurrently --handle-input \"npm run backend\" \"npm run web\"",
    "list-users": "node -r dotenv/config -e \"const { Pool } = require('pg'); const p = new Pool({ connectionString: process.env.DATABASE_URL, ssl: { rejectUnauthorized: false } }); p.query('SELECT * FROM users').then(r => { console.table(r.rows); p.end(); })\"",
    "git-status": "git status",
    "git-add": "git add .",
    "git-commit": "git commit -m",
    "git-push": "git push origin main"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.11",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo": "^55.0.23",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.13",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.21",
    "express": "^4.19.2",
    "install": "^0.13.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "pg": "^8.11.3"
  },
  "private": true
}
